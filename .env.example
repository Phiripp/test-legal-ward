# Legal Ward - environment variables (placeholders only, never commit real values)
#
# Docker Compose: non-secret defaults live in local/conf/default.
#   Copy the lines you need into local/conf/local.env (git-ignored).
# Without Docker: export these in your shell before running the backend/frontend.

# ---- Backend (Django) -------------------------------------------------------
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
# Never enable in production.
DJANGO_DEBUG=false
# Comma-separated host names the backend may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL with the pgvector extension (needed for the embedding cache).
DJANGO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webapp
# Origin of the frontend, used for CORS.
DJANGO_FRONTEND_URL=http://localhost:3000
# Open self-service signup through the allauth API. Keep false unless you need it.
DJANGO_ALLOW_REGISTRATION=false
DJANGO_LOG_LEVEL=INFO

# Required to analyse a document (embeddings + gpt-4o-mini). Browsing existing
# results works without it.
PROJECT_OPENAI_API_KEY=

# ---- Frontend (Vite) --------------------------------------------------------
# Dev server only: where the Vite proxy forwards /api and /.auth.
VITE_PROXY_BACKEND_URL=http://localhost:8000
# Production builds only: absolute backend URL baked into the bundle.
# VITE_BACKEND_URL=https://your-backend.example.com

# ---- Postgres container (Docker Compose) ------------------------------------
POSTGRES_DB=webapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
